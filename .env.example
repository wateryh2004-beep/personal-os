# Public Supabase connection values. Obtain these from the Personal OS Supabase project.
# Never put a service-role key, database password, or other private secret in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The only email address permitted to use this private application.
OWNER_EMAIL=

# Server-only Calendar Companion values. Set these only in Vercel and the
# private local bridge environment; never use a NEXT_PUBLIC_ prefix or commit
# real values. SUPABASE_SECRET_KEY is used only by the bearer-authenticated
# Companion HTTP routes to write the Outlook cache and execution results.
SUPABASE_SECRET_KEY=
CALENDAR_COMPANION_BRIDGE_TOKEN=
