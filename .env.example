# Public Supabase connection values. Obtain these from the Personal OS Supabase project.
# Never put a service-role key, database password, or other private secret in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The only email address permitted to use this private application.
OWNER_EMAIL=

# Fixed owner UUID used only by narrow background jobs. Do not accept this
# value from a request and do not scan Auth users to guess an owner.
OWNER_USER_ID=

# Server-only Supabase Secret Key. Set this only in Vercel; never use a
# NEXT_PUBLIC_ prefix or commit a real value. It is used for protected cloud
# integrations and to derive encryption for Microsoft refresh credentials.
SUPABASE_SECRET_KEY=

# Long random server-only value used only to authenticate Vercel's daily
# Microsoft backup job. Set it in Vercel Production; never use NEXT_PUBLIC_.
CRON_SECRET=

# Private Cloudflare R2 credentials for Files. Configure in Vercel only; none
# of these values may have a NEXT_PUBLIC_ prefix or be committed to Git.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=life-of-hang-files-prod
